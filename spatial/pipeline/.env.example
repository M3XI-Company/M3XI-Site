# worldengine worker — the complete environment for a RunPod pod.
#
# THE POD HOLDS ONE SECRET. There is no Supabase key here, and there is no
# code path in worldengine/worker.py that could use one. A service-role key
# bypasses RLS across every table in the project — billing, leads, AI turns,
# other tenants' properties — and these GPU boxes are rented by the minute
# from a third party and recycled between customers. Everything the worker
# needs to write goes through the wv-jobs edge function, which checks the
# job's lease and reads the tenant key from the job row.
#
# If you are here looking for where SUPABASE_SERVICE_ROLE_KEY goes: nowhere.
# Adding it back would not make the worker work better; it would make the
# blast radius of one compromised pod the whole project.

# --- required ---------------------------------------------------------------

# The wv-jobs function endpoint.
WV_JOBS_URL=https://<project-ref>.supabase.co/functions/v1/wv-jobs

# The shared worker secret. Must match the WV_WORKER_SECRET configured on the
# wv-jobs function, and must be at least 32 characters — the function fails
# closed below that, and the worker refuses to start rather than 401-looping.
# Generate with:  openssl rand -hex 32
WV_WORKER_SECRET=

# This pod's worker id: the uuid of a row already in wv_worker.
#
# Workers are provisioned out of band and cannot register themselves. That is
# a real operational step and it is the point: if a worker could mint its own
# identity with the shared secret, anyone holding that secret could create
# untraceable workers and the queue would stop being auditable. Provision with:
#
#   insert into wv_worker (name, gpu, capabilities)
#   values ('runpod-l40s-01', 'L40S',
#           '{ingest,frames,redact,pose,scale,splat,mesh,layout,semantics,graph,regions,package,quality}')
#   returning id;
#
# An empty capabilities array means "any stage"; a populated one restricts what
# this pod may claim, which is how you keep a 24 GB card off the pose stage.
WV_WORKER_ID=

# --- optional ---------------------------------------------------------------

# Where checkpointed runs live. Keyed by world id and version, so a preempted
# pod that comes back resumes rather than restarting. Mount a volume here on a
# dedicated pod; on serverless the queue will hand the job to a fresh pod that
# starts from the last completed stage instead.
WORLDENGINE_RUN_ROOT=/workspace/runs

# Cost accounting. on_demand | serverless, or override the rate directly.
WORLDENGINE_BILLING_MODE=on_demand
# WORLDENGINE_USD_PER_GPU_HOUR=1.10

# Where baked-in model weights live. Set by the Dockerfile; override only if
# you mount weights from a volume instead.
WORLDENGINE_MODEL_ROOT=/opt/models
WORLDENGINE_ROOMFORMER_ROOT=/opt/roomformer

WORLDENGINE_LOG_LEVEL=INFO
WORLDENGINE_GPU=L40S
